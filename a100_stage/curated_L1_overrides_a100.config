// Resource overrides for the DGX Station A100 (120 cores, 480 GB).
//
// Sized against the measured workstation run, which had a 20-core / 52 GB
// executor budget and hit its ceiling at maxForks 3 for Gubbins. The A100 gives
// ~5.5x the cores and ~8x the memory, so the binding constraint moves from the
// executor budget to per-task scaling.
//
// The GPU does NOT accelerate anything here -- Gubbins, snippy, IQ-TREE and
// RAxML are all CPU. The win is core count and RAM.
//
// maxForks is set generously on purpose. The executor cpus/memory budget below
// is the real cap; Nextflow will not schedule past it, so a high maxForks lets
// the scheduler fill the box with whatever mix of stages is ready rather than
// idling behind a per-process limit. That is exactly what throttled the
// workstation run: Gubbins at maxForks 3 could not use cores that snippy had
// finished with.
//
// errorStrategy and the task.attempt <= 2 guard are carried over unchanged from
// curated_L1_overrides.config. Without the guard the closure keeps retrying past
// maxRetries and the run never terminates. Do not simplify it.

executor {
    $local { cpus = 118; memory = '460 GB' }
}

process {
    withName: 'SNIPPY_SCATTER' {
        // maxForks 40 -> 48 (2026-08-19). Measured on the 2026-08-19 A100 run:
        // SNIPPY_SCATTER held mean parallelism 38.9 of its 40 slots for the whole
        // stage, so it was fork-bound, not CPU-bound -- and it is the only stage
        // whose maxForks binds before the 118-cpu executor budget (40 x 2 = 80).
        //
        // NOT 59. 59 x 2 = 118 = the entire budget, which leaves zero cores for
        // an 8-cpu GUBBINS_CLUSTER task while snippy is saturated, turning a
        // pipelined run into a phased one and starving the superlinear stage.
        // GUBBINS ran at mean parallelism 3.6 of 14 -- input-starved but still
        // overlapping; that overlap is worth protecting.
        //
        // 48 x 2 = 96 leaves 22 cores = 2 concurrent Gubbins, and takes the
        // snippy stage from 2.84 h to ~2.30 h. Total CPU is ~305 core-hours, so
        // the floor at 118 cores is 2.59 h against 3.31 h observed -- only ~0.7 h
        // is available to win, whatever this is set to.
        //
        // Next run: check GUBBINS_CLUSTER mean parallelism. If it holds at ~3.6
        // or better, push higher; if it drops, the crowding is real and measured.
        // Change this BETWEEN runs only -- editing it mid-run changes the task
        // hashes and invalidates the resume cache.
        cpus     = 2
        memory   = { task.attempt == 1 ? 4.GB : (task.attempt == 2 ? 8.GB : 16.GB) }
        time     = { task.attempt == 1 ? 4.h : 8.h }
        maxForks = 48
        errorStrategy = { (task.exitStatus in [71,104,134,137,139,140,143,255] && task.attempt <= 2) ? 'retry' : 'ignore' }
        maxRetries    = 2
    }
    withName: 'SNIPPY_CORE_GATHER' {
        cpus     = 4
        memory   = { task.attempt == 1 ? 16.GB : (task.attempt == 2 ? 32.GB : 64.GB) }
        time     = { task.attempt == 1 ? 12.h : 24.h }
        maxForks = 12
        errorStrategy = { (task.exitStatus in [71,104,134,137,139,140,143,255] && task.attempt <= 2) ? 'retry' : 'ignore' }
        maxRetries    = 2
    }
    withName: 'KEEP_INVARIANT_ATCG' {
        cpus     = 4
        memory   = { task.attempt == 1 ? 16.GB : (task.attempt == 2 ? 32.GB : 64.GB) }
        time     = { task.attempt == 1 ? 6.h  : 12.h }
        maxForks = 12
        errorStrategy = { (task.exitStatus in [71,104,134,137,139,140,143,255] && task.attempt <= 2) ? 'retry' : 'ignore' }
        maxRetries    = 2
    }
    withName: 'IQTREE_FAST' {
        cpus     = 4
        memory   = { task.attempt == 1 ? 12.GB : 24.GB }
        time     = { task.attempt == 1 ? 12.h : 24.h }
        maxForks = 12
        errorStrategy = { (task.exitStatus in [71,104,134,137,139,140,143,255] && task.attempt <= 2) ? 'retry' : 'ignore' }
        maxRetries    = 2
    }
    withName: 'ASC_PREFLIGHT' {
        errorStrategy = { (task.exitStatus in [71,104,134,137,139,140,143,255] && task.attempt <= 2) ? 'retry' : 'ignore' }
        maxRetries    = 2
    }
    withName: 'GUBBINS_CLUSTER' {
        cpus     = 8
        memory   = { task.attempt == 1 ? 24.GB : (task.attempt == 2 ? 48.GB : 96.GB) }
        time     = { task.attempt == 1 ? 72.h : 168.h }
        maxForks = 14
        errorStrategy = { (task.exitStatus in [71,104,134,137,139,140,143,255] && task.attempt <= 2) ? 'retry' : 'ignore' }
        maxRetries    = 2
    }
    withName: 'IQTREE_ASC' {
        cpus     = 8
        memory   = { task.attempt == 1 ? 20.GB : (task.attempt == 2 ? 40.GB : 80.GB) }
        time     = { task.attempt == 1 ? 48.h : 96.h }
        maxForks = 10
        errorStrategy = { (task.exitStatus in [71,104,134,137,139,140,143,255] && task.attempt <= 2) ? 'retry' : 'ignore' }
        maxRetries    = 2
    }
}
